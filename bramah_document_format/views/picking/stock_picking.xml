<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <template id="bramah_document_format.report_delivery_document"
                  inherit_id="stock.report_delivery_document">
            <xpath expr="//tr[@t-foreach='o.move_line_ids']" position="attributes">
                 <attribute name="t-foreach">sorted(o.move_line_ids, key=lambda move_line: move_line.move_id.sequence)</attribute>
                    <attribute name="t-as">move_line</attribute>
            </xpath>

            <xpath expr='//div[@name="signature"]' position="before">
                <div t-if="o.note" class="mt32 ml64 mr4" name="note">
                    <div>
                        <strong>Nota</strong>
                    </div>
                    <div>
                        <p t-field="o.note"/>
                    </div>
                </div>
            </xpath>
        </template>
    </data>
</odoo>
